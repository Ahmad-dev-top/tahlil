server {
    listen 80;
    server_name _;
    client_max_body_size 8m;

    # Prefer the edge proxy's client address. A direct caller (no header) is $remote_addr.
    set $tahlil_client $remote_addr;
    if ($http_x_forwarded_for != "") {
        set $tahlil_client $http_x_forwarded_for;
    }

    root /usr/share/nginx/html;
    index index.html;

    # Next.js static export (trailingSlash: true -> /path/index.html)
    location / {
        try_files $uri $uri/ $uri.html /index.html;
    }

    # hashed build assets can be cached forever
    location /_next/static/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Backend. The API key is added HERE so it never ships inside the browser app.
    # Protect this site itself (basic auth / VPN / Cloudflare Access) if it is public.
    location /api/ {
        proxy_pass http://api:8000/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $tahlil_client;
        proxy_set_header X-API-Key "${TAHLIL_API_KEY}";

        # Server-Sent Events (/api/ask/stream): no buffering, long reads
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
    }
}
