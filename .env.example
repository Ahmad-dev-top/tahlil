# ---- Model (any litellm model string + its provider key) ----
LLM_MODEL=anthropic/claude-haiku-5-5
# Empty = do not send temperature (works for every model). A number is sent as-is.
LLM_TEMPERATURE=
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=

# live = real model, fake = offline demo with no API key
LLM_MODE=live
# fake mode only: simulated seconds per model call, makes streaming visible in demos
DEMO_DELAY_S=0
# CrewAI report crew (false = single LLM call for the report)
USE_CREWAI=true

# ---- Sandbox ----
# docker (isolated) or local (dev only, NOT isolated)
SANDBOX_MODE=docker
SANDBOX_TIMEOUT_S=30
SANDBOX_MEMORY=512m
# On a 1 GB VM set this to 256m.

# ---- Agent retry budgets ----
MAX_SQL_ATTEMPTS=3
MAX_REPORT_ATTEMPTS=2

# ---- Database connectors ----
CONNECTOR_ROW_LIMIT=200000
CONNECTOR_MAX_TABLES=30
# comma-separated allow list of DB hosts; empty = any
CONNECTOR_ALLOWED_HOSTS=
# never enable in production (SQLite URLs are server file paths)
ALLOW_SQLITE_CONNECTOR=false

# ---- Auth / limits ----
# docker compose: the shared key between nginx (web) and the API. Empty = auth off.
TAHLIL_API_KEY=
# Host port for the API. Stay on loopback. Use another port when 8000 is already taken.
# API_HOST_PORT=8000
# running the API directly (no compose): comma-separated keys
# API_KEYS=
ASKS_PER_MINUTE=10
# Empty = unlimited. A number is how many questions may run at once in this process.
MAX_CONCURRENT_ASKS=
# How long a question waits for a free slot before HTTP 503.
QUEUE_TIMEOUT_S=60
# Public demo: delete uploaded datasets (not the sample) after this many hours.
DEMO_RETENTION_HOURS=24
CORS_ORIGINS=*
# Public demo: no outbound DB connections, 5 MB and 3 files per upload, sample dataset
# preloaded, and the rate limit is per client IP (nginx must be the trusted proxy).
PUBLIC_DEMO=false
# Empty = no daily cap. A number is USD per UTC day across every question.
DAILY_COST_LIMIT_USD=
# Compose sets this to the web service name. Direct callers cannot spoof X-Forwarded-For.
# TRUSTED_PROXIES=web
