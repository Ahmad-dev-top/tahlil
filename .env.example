# ---- Model (any litellm model string + its provider key) ----
LLM_MODEL=anthropic/claude-haiku-5-5
# Empty = do not send temperature (works for every model). A number is sent as-is.
LLM_TEMPERATURE=
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=

# live = real model, fake = offline demo with no API key
LLM_MODE=live
# fake mode only: simulated seconds per model call, makes streaming visible in demos
DEMO_DELAY_S=0
# CrewAI report crew (false = single LLM call for the report)
USE_CREWAI=true

# ---- Sandbox ----
# docker (isolated) or local (dev only, NOT isolated)
SANDBOX_MODE=docker
SANDBOX_TIMEOUT_S=30
SANDBOX_MEMORY=512m

# ---- Agent retry budgets ----
MAX_SQL_ATTEMPTS=3
MAX_REPORT_ATTEMPTS=2

# ---- Database connectors ----
CONNECTOR_ROW_LIMIT=200000
CONNECTOR_MAX_TABLES=30
# comma-separated allow list of DB hosts; empty = any
CONNECTOR_ALLOWED_HOSTS=
# never enable in production (SQLite URLs are server file paths)
ALLOW_SQLITE_CONNECTOR=false

# ---- Auth / limits ----
# docker compose: the shared key between nginx (web) and the API. Empty = auth off.
TAHLIL_API_KEY=
# running the API directly (no compose): comma-separated keys
# API_KEYS=
ASKS_PER_MINUTE=10
CORS_ORIGINS=*
